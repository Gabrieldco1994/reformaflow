{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reformaflow.invalid/deploy/ocr/review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "role", "policySha256", "scope"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "role": {
      "enum": [
        "DATA_OWNER_RISK_ACCEPTANCE",
        "SECURITY",
        "PRIVACY",
        "DATA_OWNER_FINAL"
      ]
    },
    "policySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scope": { "const": "OCR_QUALIFICATION_V1" }
  }
}
